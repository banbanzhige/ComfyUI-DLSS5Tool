    "class_type": "DLSS5ToolModelLoader",
    "_meta": {
      "title": "DLSS5 Model Loader"
    }
  },
  "3": {
    "inputs": {
      "style": "default",
      "intensity": 1,
      "local_tone": 1,
      "local_struct": 1,
      "use_auto_mask": true,
      "skin_struct": 1,
      "model": [
        "2",
        0
      ],
      "image": [
        "6",
        0
      ],
      "alpha_mask": [
        "1",
        1
      ]
    },
    "class_type": "DLSS5ToolEnhance",
    "_meta": {
      "title": "DLSS5 Enhance"
    }
  },
  "4": {
    "inputs": {
      "residualMultiplier": 1,
      "shadowStructureMultiplier": 1,
      "reflectionGlowMultiplier": 1,
      "residualSaturation": 1,
      "residualLightness": 1,
      "total": 1,
      "darken": 1,
      "brighten": 1,
      "color": 1,
      "luminance": 1,
      "output_mix": 1,
      "mask_feather": 0,
      "result": [
        "3",
        1
      ]
