    "class_type": "SaveImageAdvanced",
    "_meta": {
      "title": "保存图像（高级）"
    }
  },
  "6": {
    "inputs": {
      "algorithm": "lottes",
      "algorithm.target_luminance": 1000,
      "image": [
        "1",
        0
      ]
    },
    "class_type": "ImageSDRToHDR",
    "_meta": {
      "title": "将 SDR 转换为 HDR"
    }
  }
