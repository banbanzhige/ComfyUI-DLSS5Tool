    "class_type": "DLSS5ToolAdjust",
    "_meta": {
      "title": "DLSS5 Adjust"
    }
  },
  "5": {
    "inputs": {
      "filename_prefix": "hdr10_hlg",
      "format": "exr",
      "format.bit_depth": "32-bit float",
