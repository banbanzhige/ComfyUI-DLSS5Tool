{
  "1": {
    "inputs": {
      "image": "contract.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "加载图像"
    }
  },
  "2": {
    "inputs": {
      "render_gpu": "auto",
      "dll_selection": "auto",
      "dll_path": ""
